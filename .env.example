# DATAPRISM Configuration Example
# Copy to .env and configure for your local environment

# Application
APP_ENV=development
APP_NAME=DATAPRISM
PORT=8000
DEBUG=false

# Security & Authentication (Generate a strong 32-byte secret for production)
SECRET_KEY=change-me-to-a-secure-random-32-byte-hex-string-for-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALGORITHM=HS256

# Database (PostgreSQL)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=nexusiq
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nexusiq

# Analytics Database (Read-Only User for Secure SQL Execution)
ANALYTICS_RO_USER=analytics_ro
ANALYTICS_RO_PASSWORD=analytics_ro_password
ANALYTICS_DATABASE_URL=postgresql://analytics_ro:analytics_ro_password@localhost:5432/nexusiq

# Storage & Ingestion
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_SIZE_MB=50
ALLOWED_EXTENSIONS=csv,parquet

# Query Execution Limits
QUERY_TIMEOUT_SECONDS=30
QUERY_MAX_RESULT_ROWS=1000

# CORS & Frontend
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
VITE_API_BASE_URL=http://localhost:8000/api/v1
